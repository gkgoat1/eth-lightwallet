{
  "name": "eth-lightwallet",
  "version": "5.0.0-alpha.0",
  "description": "A lightweight ethereum javascript wallet.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ConsenSys/eth-lightwallet.git"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project golden",
    "test:legacy-harness": "./node_modules/.bin/mocha --reporter dot",
    "coverage": "vitest run --coverage",
    "gen:goldens": "node scripts/generate-goldens.js",
    "smoke": "npm run build && node scripts/smoke-pack.cjs"
  },
  "keywords": [
    "ethereum",
    "blockchain",
    "transactions",
    "contracts",
    "wallet"
  ],
  "contributors": [
    {
      "name": "Christian Lundkvist",
      "email": "christian.lundkvist@gmail.com"
    },
    {
      "name": "Tyler Clark",
      "email": "tysclark@gmail.com"
    },
    {
      "name": "Joel Torstensson",
      "email": "me@joeltorstensson.se"
    },
    {
      "name": "Zach Ferland",
      "email": "zachferland@gmail.com"
    },
    {
      "name": "Kevin Jiao",
      "email": "kevin.jiao@berkeley.edu"
    },
    {
      "name": "Marian Oancea",
      "email": "marian.oancea@gmail.com"
    },
    {
      "name": "John McDowall",
      "email": "john@kantan.io"
    },
    {
      "name": "Milad Mostavi",
      "email": "milad.mostavi@gmail.com"
    },
    {
      "name": "Slava Matvienco",
      "email": "slava.matvienco@gmail.com"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@ethereumjs/rlp": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "bitcore-lib": "8.1.1",
    "bitcore-mnemonic": "8.1.1",
    "crypto-js": "3.1.8",
    "elliptic": "6.4.1",
    "ethereumjs-tx": "1.3.7",
    "ethereumjs-util": "6.1.0",
    "micro-eth-signer": "0.20.1",
    "rlp": "2.2.3",
    "scrypt-async": "2.0.1",
    "tweetnacl": "1.0.3",
    "tweetnacl-util": "0.15.0",
    "viem": "2.57.4",
    "web3": "0.20.7"
  },
  "devDependencies": {
    "@babel/core": "7.4.0",
    "@babel/preset-env": "7.4.2",
    "@babel/preset-react": "7.0.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "async": "2.6.2",
    "babelify": "10.0.0",
    "bluebird": "3.5.3",
    "browserify": "16.2.3",
    "chai": "4.2.0",
    "istanbul": "0.4.5",
    "mocha": "6.0.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "uglify-js": "3.5.2",
    "vitest": "5.0.3"
  }
}
